{
  "name": "domguard",
  "version": "0.1.0",
  "description": "Static + runtime safety checks for LLM-generated browser JavaScript. Detects browser-hang patterns (infinite scroll loops, runaway recursion, mutation feedback, etc.) before deployment.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime-guard.js",
      "types": "./dist/runtime-guard.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "experiments:collect": "node --env-file-if-exists=.env --import tsx experiments/corpus-collect.ts",
    "experiments:collect:interactive": "PROMPTS_FILE=prompts-interactive.jsonl node --env-file-if-exists=.env --import tsx experiments/corpus-collect.ts",
    "experiments:collect:seeded": "node --env-file-if-exists=.env --import tsx experiments/corpus-collect-seeded.ts",
    "experiments:score": "node --env-file-if-exists=.env --import tsx experiments/score-corpus.ts",
    "experiments:analyze": "node --env-file-if-exists=.env --import tsx experiments/analyze.ts",
    "experiments:validate": "node --import tsx experiments/validate-detectors.ts",
    "paper:view": "node paper/view.mjs",
    "paper:pdf": "make -C paper",
    "paper:pdf:watch": "make -C paper watch",
    "paper:check": "make -C paper check"
  },
  "keywords": [
    "llm",
    "codegen",
    "ai-safety",
    "static-analysis",
    "browser",
    "javascript",
    "code-quality",
    "llm4code"
  ],
  "author": "Sakti Kumar Chourasia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saktikumar/domguard.git"
  },
  "bugs": {
    "url": "https://github.com/saktikumar/domguard/issues"
  },
  "homepage": "https://github.com/saktikumar/domguard#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "marked": "^12.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.79",
    "@ai-sdk/google": "^3.0.79",
    "@ai-sdk/openai": "^3.0.65",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "ai": "^6.0.191"
  }
}
